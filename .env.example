# Environment Mode (production / development)
NODE_ENV=production

# Note: PORT is managed dynamically by Hostinger Node.js Web App environment
# PORT=3000

# Client Allowed CORS Origin
FRONTEND_URL=https://greenfarmmarket.com

# Hostinger Managed MySQL Connection URL Template
# Format: mysql://DB_USER:URL_ENCODED_DB_PASSWORD@DB_HOST:3306/DB_NAME
# Note: Encode special characters (e.g., @ -> %40, # -> %23)
DATABASE_URL=mysql://DB_USER:URL_ENCODED_DB_PASSWORD@DB_HOST:3306/DB_NAME

# JWT Security Secrets & Token Expirations (Configure in Hostinger hPanel Environment Variables)
JWT_ACCESS_SECRET=place_strong_jwt_access_secret_here
JWT_REFRESH_SECRET=place_strong_jwt_refresh_secret_here
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Upload Directory
UPLOAD_DIR=uploads

# AI Diagnostics API Credentials
AI_API_URL=https://api.greenfarm-ai.example.com/v1
AI_API_KEY=place_production_ai_api_key_here
